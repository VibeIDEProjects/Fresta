{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fresta.local/schemas/client.schema.json",
  "title": "fresta · sing-box client.json (VLESS+Reality+TCP+utls)",
  "description": "JSON Schema для client.json (sing-box). Минимальный набор: outbounds (vless+reality). Полный (с log/inbounds) тоже валиден — sing-box расширяемый, мы валидируем только наш кусок.",
  "type": "object",
  "required": ["outbounds"],
  "properties": {
    "outbounds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "tag", "server", "server_port", "uuid", "network", "tls"],
        "properties": {
          "type":       { "type": "string", "const": "vless" },
          "tag":        { "type": "string", "minLength": 1 },
          "server":     { "type": "string", "description": "IP-литерал (НЕ домен)" },
          "server_port":{ "type": "integer", "minimum": 1, "maximum": 65535 },
          "uuid":       { "type": "string", "format": "uuid" },
          "flow":       { "type": "string", "maxLength": 0 },
          "network":    { "type": "string", "const": "tcp" },
          "tls": {
            "type": "object",
            "required": ["enabled", "server_name", "utls", "reality"],
            "properties": {
              "enabled":     { "type": "boolean", "const": true },
              "server_name": { "type": "string", "minLength": 1 },
              "utls": {
                "type": "object",
                "required": ["enabled", "fingerprint"],
                "properties": {
                  "enabled":     { "type": "boolean", "const": true },
                  "fingerprint": {
                    "type": "string",
                    "enum": ["chrome", "firefox", "safari", "edge", "qq", "random", "ios", "android"]
                  }
                }
              },
              "reality": {
                "type": "object",
                "required": ["enabled", "public_key", "short_id"],
                "properties": {
                  "enabled": { "type": "boolean", "const": true },
                  "public_key": {
                    "type": "string",
                    "description": "X25519 public key, base64url без padding, 43 символа. Также принимает плейсхолдер для демо-конфигов.",
                    "oneOf": [
                      { "const": "PUBLIC_KEY_REPLACE_ME_BASE64URL",
                        "description": "плейсхолдер (демо configs/default/)" },
                      { "pattern": "^[A-Za-z0-9_-]{43}$",
                        "description": "настоящий X25519 public key" }
                    ]
                  },
                  "short_id": {
                    "type": "string",
                    "pattern": "^[0-9a-fA-F]{0,16}$"
                  }
                }
              }
            }
          }
        }
      }
    },
    "route": {
      "type": "object",
      "properties": {
        "final": { "type": "string" }
      }
    }
  }
}
